rules_version = '2';

// Rules for the CNKC project (`cannabis-network-kc`), default database.
//
// This project serves one client. The sites/{siteId}/ layout is kept anyway so
// these rules, the admin page and scripts/add-editor.py stay identical across
// client sites — the next client is a copy, not a rewrite.
service cloud.firestore {
  match /databases/{database}/documents {

    // Who may edit this site. The list lives at
    //   sites/{siteId}/admin/editors  ->  { uids: ["abc123", ...] }
    // which sits OUTSIDE public/, so the browser can never read it — but
    // get() inside rules runs server-side and bypasses that.
    //
    // exists() first, so a site with no editors doc denies cleanly instead of
    // erroring on the get().
    function isEditor(siteId) {
      return request.auth != null
        && exists(/databases/$(database)/documents/sites/$(siteId)/admin/editors)
        && request.auth.uid in get(/databases/$(database)/documents/sites/$(siteId)/admin/editors).data.uids;
    }

    // Published site content — anything a visitor is meant to see without
    // signing in. Reads are open. Writes come from cnkc/admin.html, but only
    // for a signed-in uid listed as an editor.
    match /sites/{siteId}/public/{document=**} {
      allow read: if true;
      allow write: if isEditor(siteId);
    }

    // Everything else under a site is server-only, including the editors list
    // above. Client SDK reads and writes are denied outright.
    match /sites/{siteId}/{document=**} {
      allow read, write: if false;
    }

    // Default deny for anything outside the sites/ tree.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
